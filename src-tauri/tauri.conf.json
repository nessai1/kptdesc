{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "КПТ-дневник",
  "version": "0.1.0",
  "identifier": "com.kptdesc.diary",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "КПТ-дневник",
        "width": 1000,
        "height": 860,
        "minWidth": 720,
        "minHeight": 560,
        "backgroundColor": "#F6EEE2"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
